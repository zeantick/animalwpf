<Window x:Class="animalwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animal WPF" Height="400" Width="700">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Список животных -->
        <ListBox ItemsSource="{Binding Animals}"
                 SelectedItem="{Binding SelectedAnimal}"
                 DisplayMemberPath="Name" />

        <!-- Правая панель -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Name:" />
            <TextBlock Text="{Binding SelectedAnimal.Name}" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Age:" />
            <TextBlock Text="{Binding SelectedAnimal.Age}" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBox x:Name="FoodTextBox" Width="150" Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,10">
                <Button Content="Make Sound" Width="100" Margin="0,0,5,0" Click="MakeSoundButton_Click"/>
                <Button Content="Feed" Width="80" Margin="0,0,5,0" Click="FeedButton_Click"/>
                <Button Content="Crazy Action" Width="100" Click="CrazyActionButton_Click"/>
            </WrapPanel>

            <TextBox x:Name="NewAnimalTextBox" Width="150" Margin="0,0,0,10" Text=""/>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="Add Animal" Width="100" Margin="0,0,5,0" Click="AddAnimalButton_Click"/>
                <Button Content="Remove Animal" Width="100" Click="RemoveAnimalButton_Click"/>
            </WrapPanel>
            <Button Content="Show Stats" Width="120" Click="ShowStatsButton_Click" Margin="0,0,0,10"/>


            <TextBlock Text="Log:" Margin="0,10,0,0"/>
            <ListBox ItemsSource="{Binding Log}" Height="150"/>
        </StackPanel>
    </Grid>
</Window>
